# Supabase (server writes need SERVICE_ROLE_KEY — not the publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin stealth auth
ADMIN_SECRET_WORD=secretpage
ADMIN_EMAIL=your-email@example.com
ADMIN_TOTP_SECRET=generate-with-authenticator-setup

# Email — Resend (recommended) or SMTP
EMAIL_ENABLED=true
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=onboarding@resend.dev

# Email — SMTP fallback
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# Google OAuth client ID — not used by current MVP auth (TOTP is used for 2FA)
# GOOGLE_CLIENT_ID=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SESSION_TTL_MINUTES=10
ADMIN_WRITE_IDLE_MINUTES=5
MAGIC_LINK_TTL_MINUTES=10
EMAIL_RETRY_ATTEMPTS=3
TREND_IMPORT_USER_AGENT=CacheMeOutside/0.1 admin@example.com
